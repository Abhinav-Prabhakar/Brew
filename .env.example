# brew — optional settings. Copy to .env (git-ignored); real environment variables win over this file.

# --- the waiter's LLM pool (brew.llm.pool). Leave everything empty and Kapi uses his scripted answers. ---
# Several keys per provider: comma separated. Calls rotate over every (provider, key); a failing key rests and the
# call moves on to the next one.
ANTHROPIC_API_KEYS=
OPENAI_API_KEYS=
GEMINI_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=

# Which providers to use, in what order (default: every provider above that has a key)
# BREW_LLM_ORDER=anthropic,groq,openai
# round_robin (default) rotates over all providers and keys; priority uses the first provider until its keys are down
# BREW_LLM_STRATEGY=round_robin
# Per-provider overrides, and any other OpenAI-compatible endpoint:
# BREW_LLM_ANTHROPIC_MODEL=claude-haiku-5-5
# BREW_LLM_MYHOST_URL=https://example.com/v1/chat/completions
# BREW_LLM_MYHOST_MODEL=some-model
# MYHOST_API_KEYS=
# BREW_LLM_ENABLED=0   # scripted waiter only

# --- the waiter's voice (brew.llm.tts): text-to-speech, only for turns you speak ---
# Providers are tried in this order; a failing key rests and the next one takes over. "browser" = the browser's own
# voice, free and keyless, as the last resort (leave it out to stay silent instead).
# BREW_TTS_ORDER=elevenlabs,openai,groq,browser
# Keys are shared with the chat pool (OPENAI_API_KEYS, GROQ_API_KEYS, …); TTS-only providers get their own:
ELEVENLABS_API_KEYS=
# Per provider: voice, model, URL, and (OpenAI-style) how to say it
# BREW_TTS_ELEVENLABS_VOICE=JBFqnCBsd6RMkjVDRZzb        # a voice id from your ElevenLabs voice library
# BREW_TTS_OPENAI_VOICE=ballad
# BREW_TTS_OPENAI_INSTRUCTIONS=A dry, tired, sarcastic but kind cafe waiter.
# BREW_TTS_GROQ_VOICE=Fritz-PlayAI
# Any other OpenAI-compatible speech endpoint:
# BREW_TTS_MYHOST_URL=https://example.com/v1/audio/speech
# BREW_TTS_MYHOST_MODEL=tts-1
# BREW_TTS_MYHOST_VOICE=fable
# MYHOST_API_KEYS=
# A plain GET service ({text} {voice} {key} are filled in):
# BREW_TTS_FUNNY_KIND=get
# BREW_TTS_FUNNY_URL=https://example.com/speech?voice={voice}&text={text}&key={key}
# The browser fallback: part of a voice name, pitch 0-2 (low = grumpy), rate 0.5-2
# BREW_TTS_BROWSER_VOICE=
# BREW_TTS_BROWSER_PITCH=0.8
# BREW_TTS_BROWSER_RATE=1.05
